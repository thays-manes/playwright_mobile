{
  "name": "mobile-wdio-appium",
  "version": "1.0.0",
  "description": "Projeto base de automação mobile (Android e iOS) com WebdriverIO + Appium + JavaScript",
  "type": "module",
  "scripts": {
    "appium:drivers": "appium driver install uiautomator2 && appium driver install xcuitest",
    "appium:doctor": "appium-doctor --android",
    "test:android": "wdio run ./config/wdio.android.conf.js",
    "test:ios": "wdio run ./config/wdio.ios.conf.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [
    "webdriverio",
    "appium",
    "mobile",
    "android",
    "ios",
    "qa"
  ],
  "author": "Thays Manes",
  "license": "ISC",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "allure-commandline": "^2.0.0",
    "appium": "^2.0.0",
    "dotenv": "^16.0.0",
    "webdriverio": "^9.0.0"
  }
}
